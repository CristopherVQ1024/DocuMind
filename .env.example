# Gemini: crear la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Firebase: ID del proyecto en la consola de Firebase, Project settings
FIREBASE_PROJECT_ID=

# Qdrant: en compose apunta al contenedor, en local al puerto publicado
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documind

# Solo desarrollo local sin login real
DEV_AUTH_BYPASS=false

MAX_UPLOAD_MB=20
MAX_PAGES=300
CORS_ORIGINS=http://localhost:4200
